{
  "name": "@thundermail/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:check": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc"
  },
  "dependencies": {
    "postal-mime": "2.7.4",
    "sanitize-html": "2.17.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/sanitize-html": "2.16.0",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  }
}
