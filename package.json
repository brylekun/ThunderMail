{
  "name": "thundermail",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:web": "vinext dev",
    "dev:worker": "pnpm --dir worker dev",
    "build": "vinext build",
    "build:vercel": "NITRO_PRESET=vercel vinext build",
    "deploy:web": "pnpm build:vercel && pnpm dlx vercel deploy --prebuilt --prod",
    "start": "vinext start",
    "lint": "oxlint app components/mailbox-app.tsx components/ui/button.tsx components/ui/badge.tsx components/ui/separator.tsx lib db worker/src vite.config.ts drizzle.config.ts",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "pnpm --dir worker db:migrate:local",
    "worker:check": "pnpm --dir worker deploy:check"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "drizzle-orm": "0.45.2",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "nitro": "3.0.260610-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "drizzle-kit": "0.31.10"
  },
  "type": "module"
}
